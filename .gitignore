# Asset metadata should be tracked,
# except metadata for ignored folders/files below.

# Uncomment this if you do not want the Asset Store Tools
# /[Aa]ssets/AssetStoreTools*

# Visual Studio cache
.vs/

# Gradle cache
.gradle/

# Autogenerated JetBrains Rider project files
ExportedObj/
.idea/

# Autogenerated Visual Studio / MonoDevelop files
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity generated meta files for crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crash reports
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Addressables temporary files
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# Plastic SCM / Unity Version Control
/[Aa]ssets/[Pp]lugins/Editor/JetBrains*
/.collabignore

# OS generated files
.DS_Store
Thumbs.db
desktop.ini

# IDE / editor files
*.swp
*.swo
*~
# Only track the Scripts folder
/*
!/.gitignore
!/.gitattributes
!/Assets/
/Assets/*
!/Assets/Scripts/
!/Assets/Scripts.meta